# Ignore editor and IDE settings
.idea/
.vscode/
.cursor/
.specify/
.claude/
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz

# Ignore build and distribution directories
backup/
bin/
lxgate/
dist/
/release/
node_modules/

# Ignore compiled binaries
main
lxgate

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
*.syso
lxgate.db
lxgate.db-shm
lxgate.db-wal
system_metrics.gob
*.dump

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env

# Local runtime data (never commit)
vpngate_data/.api_token
vpngate_data/*.db
# Written by the panel into the directory it runs the engine from, so a checkout
# that ran the panel once must not look dirty.
vpngate/.lxgate-engine-version

# Held back on first push: the GitHub App lacks the `workflows` permission.
# Remove this rule (and add these files back) after granting/entering them via GitHub.
.github/workflows/

# Python bytecode (vpngate sidecar)
__pycache__/
*.py[cod]

# Local node_modules symlinks (the directory pattern above does not match a symlink)
/frontend/node_modules
