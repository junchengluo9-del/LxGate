#!/sbin/openrc-run

command="/usr/local/lxgate/lxgate"
command_background=true
pidfile="/run/lxgate.pid"
description="lxgate Service"
procname="lxgate"
depend() {
    need net
}
start_pre(){
    cd /usr/local/lxgate
}
reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  kill -USR1 $(cat $pidfile)
  eend $?
}